# ─────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ─────────────────────────────────────────
# Google Gemini
# ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
APP_SECRET=change-this-to-a-random-secret
# Port (Render sets this automatically)
PORT=8000
